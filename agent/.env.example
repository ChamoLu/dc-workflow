# Copy to .env in this directory. Values below do not contain real credentials.
DC_MODEL_BASE_URL=https://your-provider.example/v1
DC_MODEL_NAME=your-model-name
DC_MODEL_API_STYLE=chat_completions
DC_MODEL_API_KEY=
DC_MODEL_TIMEOUT=240
DC_MODEL_MAX_TOKENS=12000
DC_MODEL_DESIGN_MAX_TOKENS=4000
DC_MODEL_GENERATE_MAX_TOKENS=16000
DC_MODEL_REVIEW_MAX_TOKENS=4000
DC_MODEL_PREFLIGHT_MAX_TOKENS=800
# Coarse model-only source check. Only an explicit no_data blocks generation.
DC_PREFLIGHT_TIMEOUT=90
# GPT reasoning models may require max_completion_tokens. Use only parameters supported by provider.
DC_MODEL_TOKEN_PARAMETER=max_tokens
# Leave empty to omit; e.g. low when the configured model/provider supports it.
DC_MODEL_REASONING_EFFORT=
DC_MODEL_JSON_MODE=true
DC_MODEL_STREAM=true
DC_MODEL_RETRIES=1
DC_MODEL_RETRY_SHORT_INCOMPLETE=true
DC_MAX_CONTEXT_CHARS=250000
DC_TASK_TIMEOUT=600
DC_MAX_REPAIRS=4
DC_MAX_QUALITY_REPAIRS=2
DC_REPAIR_PATIENCE=2
DC_RUNTIME_DIR=runtime
# Optional. If omitted, code is a sibling of the configured runtime directory.
DC_CODE_DIR=code
# Maintained task catalog and optional generation-reference sheets; reread on generation/rebuild.
DC_RULE_DIR=rule
DC_TODO_FILENAME=todo.xlsx
DC_INDICATOR_REFERENCE_FILENAME=IndicatorName_Excel_Md.xlsx
DC_HTML_REFERENCE_FILENAME=rule_html.xlsx
DC_MAX_RULE_BYTES=100000000
# Local dc development is the default. Set docker to enable the retained adapter.
DC_RUNNER=local
DC_DOCKER_IMAGE=dc-agent-runner:local
DC_RUNNER_TIMEOUT=40
# Local execution uses this Python interpreter in a subprocess, not a sandbox.
DC_ALLOW_UNSAFE_LOCAL_EXECUTION=true
DC_DOWNLOAD_BASE_URL=http://service-1.example.invalid/api/file/download/
DC_DOWNLOAD_TIMEOUT=30
DC_SKILL_ROOT=C:/Users/YOUR_USER/.agents/skills
