# Run `python run_service.py init-config` to create a private token and local config.
# The launcher reads the original .env first, then runtime/service/service.env.
DC_API_HOST=0.0.0.0
DC_API_PORT=8765
DC_API_TOKEN=replace-with-a-separate-random-token-at-least-24-characters
DC_API_JOB_TIMEOUT=360
DC_API_GENERATION_TIMEOUT=300
DC_API_POLL_MAX_WAIT=20
DC_API_IDEMPOTENCY_TTL=900
DC_API_WORKER_POLL_INTERVAL=0.25
