    "scriptType": "Python3",
    "scriptCode": "# -*- coding: utf-8 -*-\n\n\"\"\"\n区分嫌疑数据规则：\n\n输入：\n    OUTDATA\n\n输出：\n    OUTDATA\n    warningdata\n\n校验规则：\n\n1. indicator_release_frequency 为“月”时：\n   end_date 必须是对应月份最后一天\n   → remark = \"截止日期不是月末\"\n\n2. indicator_release_frequency 为“季”时：\n   end_date 必须是3月、6月、9月、12月的最后一天\n   → remark = \"截止日期不是季末\"\n\n3. indicator_release_frequency 为“半年”时：\n   end_date 必须是6月或12月的最后一天\n   → remark = \"截止日期不是半年末\"\n\n4. indicator_release_frequency 为“年”时：\n   end_date 必须是12月31日\n   → remark = \"截止日期不是年末\"\n\n5. 同一条数据存在多个问题：\n   → warningdata 只放一次\n   → remark 合并多个问题\n\n6. OUTDATA 原样输出，不删除数据。\n\n7. warningdata 无异常时：\n   indicator_code = \"empty\"\n   indicator_name = \"empty\"\n\n说明：\n- indicator_data 为0不再作为异常判断。\n\"\"\"\n\nimport calendar\nimport datetime\n\n\ndef is_empty(value):\n    \"\"\"判断字段是否为空\"\"\"\n\n    if value is None:\n        return True\n\n    if isinstance(value, str):\n        return value.strip() == \"\"\n\n    return False\n\n\ndef parse_date(value):\n    \"\"\"将常见日期格式转换为date，解析失败返回None\"\"\"\n\n    if value is None:\n        return None\n\n    if isinstance(value, datetime.datetime):\n        return value.date()\n\n    if isinstance(value, datetime.date):\n        return value\n\n    text = str(value).strip()\n\n    if not text:\n        return None\n\n    formats = [\n        \"%Y-%m-%d\",\n        \"%Y/%m/%d\",\n        \"%Y.%m.%d\",\n        \"%Y年%m月%d日\",\n        \"%Y年%m月%d号\",\n        \"%Y-%m-%d %H:%M:%S\",\n        \"%Y/%m/%d %H:%M:%S\",\n    ]\n\n    for fmt in formats:\n\n        try:\n            return datetime.datetime.strptime(\n                text,\n                fmt\n            ).date()\n\n        except ValueError:\n            continue\n\n    return None\n\n\ndef is_month_end(value):\n    \"\"\"判断是否为月末\"\"\"\n\n    dt = parse_date(value)\n\n    if dt is None:\n        return False\n\n    last_day = calendar.monthrange(\n        dt.year,\n        dt.month\n    )[1]\n\n    return dt.day == last_day\n\n\ndef is_quarter_end(value):\n    \"\"\"判断是否为季末\"\"\"\n\n    dt = parse_date(value)\n\n    if dt is None:\n        return False\n\n    return (\n        dt.month in (3, 6, 9, 12)\n        and is_month_end(dt)\n    )\n\n\ndef is_half_year_end(value):\n    \"\"\"判断是否为半年末\"\"\"\n\n    dt = parse_date(value)\n\n    if dt is None:\n        return False\n\n    return (\n        dt.month in (6, 12)\n        and is_month_end(dt)\n    )\n\n\ndef is_year_end(value):\n    \"\"\"判断是否为年末\"\"\"\n\n    dt = parse_date(value)\n\n    if dt is None:\n        return False\n\n    return (\n        dt.month == 12\n        and dt.day == 31\n    )\n\n\ndef main(params):\n\n    OUTDATA = params.get(\n        \"OUTDATA\",\n        []\n    )\n\n    if not isinstance(\n        OUTDATA,\n        list\n    ):\n        OUTDATA = []\n\n    warningdata = []\n\n    for data in OUTDATA:\n\n        if not isinstance(\n            data,\n            dict\n        ):\n            continue\n\n        remarks = []\n\n        # =========================\n        # 获取频率和截止日期\n        # =========================\n\n        frequency = str(\n            data.get(\n                \"indicator_release_frequency\"\n            ) or \"\"\n        ).strip()\n\n        end_date = data.get(\n            \"end_date\"\n        )\n\n        # =========================\n        # 规则1：月频\n        # =========================\n\n        if frequency == \"月\":\n\n            if not is_empty(\n                end_date\n            ):\n\n                if not is_month_end(\n                    end_date\n                ):\n\n                    remarks.append(\n                        \"截止日期不是月末\"\n                    )\n\n        # =========================\n        # 规则2：季频\n        # =========================\n\n        elif frequency == \"季\":\n\n            if not is_empty(\n                end_date\n            ):\n\n                if not is_quarter_end(\n                    end_date\n                ):\n\n                    remarks.append(\n                        \"截止日期不是季末\"\n                    )\n\n        # =========================\n        # 规则3：半年频\n        # =========================\n\n        elif frequency == \"半年\":\n\n            if not is_empty(\n                end_date\n            ):\n\n                if not is_half_year_end(\n                    end_date\n                ):\n\n                    remarks.append(\n                        \"截止日期不是半年末\"\n                    )\n\n        # =========================\n        # 规则4：年频\n        # =========================\n\n        elif frequency == \"年\":\n\n            if not is_empty(\n                end_date\n            ):\n\n                if not is_year_end(\n                    end_date\n                ):\n\n                    remarks.append(\n                        \"截止日期不是年末\"\n                    )\n\n        # =========================\n        # 有异常则进入warningdata\n        # =========================\n\n        if remarks:\n\n            warning_item = data.copy()\n\n            warning_item[\n                \"remark\"\n            ] = \"；\".join(\n                remarks\n            )\n\n            warningdata.append(\n                warning_item\n            )\n\n    # =========================\n    # 没有异常时生成占位数据\n    # =========================\n\n    if not warningdata:\n\n        warningdata.append({\n            \"indicator_code\": \"empty\",\n            \"indicator_name\": \"empty\"\n        })\n\n    return {\n        \"OUTDATA\": OUTDATA,\n        \"warningdata\": warningdata\n    }",
