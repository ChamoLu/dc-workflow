    "scriptType": "Python3",
    "scriptCode": "# -*- coding: utf-8 -*-\n\n\"\"\"\n前置校验规则：\n\n输入：\n    OUTDATA\n\n输出：\n    OUTDATA\n    warningdata\n\n校验规则：\n\n1. indicator_code 长度不是10位：\n   → 放入 warningdata\n   → remark = \"指标代码长度不是10位\"\n\n2. publictime > 当前系统日期：\n   → 放入 warningdata\n   → remark = \"信息发布日期-信息发布日期大于当前系统日期\"\n\n3. publictime < end_date：\n   → 放入 warningdata\n   → remark = \"信息发布日期-信息发布日期小于截止日期\"\n\n4. indicator_release_frequency 根据披露频率校验 end_date：\n\n   月：\n   → end_date 必须是所在月份最后一天\n   → 否则 remark = \"截止日期不是月末\"\n\n   季：\n   → end_date 必须是：\n      03-31\n      06-30\n      09-30\n      12-31\n   → 否则 remark = \"截止日期不是季末\"\n\n   半年：\n   → end_date 必须是：\n      06-30\n      12-31\n   → 否则 remark = \"截止日期不是半年末\"\n\n   年：\n   → end_date 必须是：\n      12-31\n   → 否则 remark = \"截止日期不是年末\"\n\n5. problem_fin_time 结合 end_date 独立判断：\n\n   1002：\n   → end_date 必须是月末\n   → 否则 remark = \"非月末数据\"\n\n   1003：\n   → end_date 必须是季末\n   → 否则 remark = \"非季末数据\"\n\n   1004：\n   → end_date 必须是年末\n   → 否则 remark = \"非年末数据\"\n\n处理：\n- indicator_release_frequency 和 problem_fin_time 是两个独立字段，\n  分别执行各自的校验逻辑。\n- indicator_data 是否为0不再校验。\n- unit_ratio 不再校验。\n- 同一条数据存在多个问题时，warningdata 只放一次。\n- 多个问题合并到 remark。\n- 相同 remark 不重复。\n- OUTDATA 原样输出，不删除数据。\n- warningdata 无异常时生成 empty 占位数据。\n\"\"\"\n\nimport calendar\nimport datetime\n\n\ndef has_value(value):\n    \"\"\"判断字段是否有值\"\"\"\n\n    if value is None:\n        return False\n\n    if isinstance(value, str):\n        return value.strip() != \"\"\n\n    return True\n\n\ndef parse_date(value):\n    \"\"\"\n    将常见日期格式转换为 date。\n    解析失败返回 None。\n    \"\"\"\n\n    if value is None:\n        return None\n\n    if isinstance(value, datetime.datetime):\n        return value.date()\n\n    if isinstance(value, datetime.date):\n        return value\n\n    text = str(value).strip()\n\n    if not text:\n        return None\n\n    formats = [\n        \"%Y-%m-%d\",\n        \"%Y/%m/%d\",\n        \"%Y.%m.%d\",\n        \"%Y年%m月%d日\",\n        \"%Y年%m月%d号\",\n        \"%Y-%m-%d %H:%M:%S\",\n        \"%Y/%m/%d %H:%M:%S\",\n    ]\n\n    for fmt in formats:\n        try:\n            return datetime.datetime.strptime(\n                text,\n                fmt\n            ).date()\n        except ValueError:\n            continue\n\n    # ISO格式兜底\n    try:\n        return datetime.datetime.fromisoformat(\n            text.replace(\"Z\", \"+00:00\")\n        ).date()\n    except Exception:\n        pass\n\n    return None\n\n\ndef is_month_end(value):\n    \"\"\"\n    判断是否为月末。\n    \"\"\"\n\n    dt = parse_date(value)\n\n    if dt is None:\n        return False\n\n    last_day = calendar.monthrange(\n        dt.year,\n        dt.month\n    )[1]\n\n    return dt.day == last_day\n\n\ndef is_quarter_end(value):\n    \"\"\"\n    判断是否为季末。\n\n    合法日期：\n    03-31\n    06-30\n    09-30\n    12-31\n    \"\"\"\n\n    dt = parse_date(value)\n\n    if dt is None:\n        return False\n\n    return (\n        dt.month in (3, 6, 9, 12)\n        and is_month_end(dt)\n    )\n\n\ndef is_half_year_end(value):\n    \"\"\"\n    判断是否为半年末。\n\n    合法日期：\n    06-30\n    12-31\n    \"\"\"\n\n    dt = parse_date(value)\n\n    if dt is None:\n        return False\n\n    return (\n        dt.month in (6, 12)\n        and is_month_end(dt)\n    )\n\n\ndef is_year_end(value):\n    \"\"\"\n    判断是否为年末。\n\n    合法日期：\n    12-31\n    \"\"\"\n\n    dt = parse_date(value)\n\n    if dt is None:\n        return False\n\n    return (\n        dt.month == 12\n        and dt.day == 31\n    )\n\n\ndef add_remark(remarks, remark):\n    \"\"\"\n    添加remark，相同remark不重复。\n    \"\"\"\n\n    if remark not in remarks:\n        remarks.append(remark)\n\n\ndef main(params):\n\n    # ==================================================\n    # 获取输入\n    # ==================================================\n\n    OUTDATA = params.get(\n        \"OUTDATA\",\n        []\n    )\n\n    if not isinstance(\n        OUTDATA,\n        list\n    ):\n        OUTDATA = []\n\n    warningdata = []\n\n    today = datetime.date.today()\n\n    # ==================================================\n    # 逐条校验 OUTDATA\n    # ==================================================\n\n    for data in OUTDATA:\n\n        if not isinstance(\n            data,\n            dict\n        ):\n            continue\n\n        remarks = []\n\n        # ==================================================\n        # 获取字段\n        # ==================================================\n\n        indicator_code = str(\n            data.get(\n                \"indicator_code\"\n            ) or \"\"\n        ).strip()\n\n        publictime = data.get(\n            \"publictime\",\n            \"\"\n        )\n\n        end_date = data.get(\n            \"end_date\",\n            \"\"\n        )\n\n        indicator_release_frequency = str(\n            data.get(\n                \"indicator_release_frequency\"\n            ) or \"\"\n        ).strip()\n\n        problem_fin_time = data.get(\n            \"problem_fin_time\",\n            \"\"\n        )\n\n        # ==================================================\n        # 日期转换\n        # ==================================================\n\n        publictime_date = parse_date(\n            publictime\n        )\n\n        end_date_obj = parse_date(\n            end_date\n        )\n\n        # ==================================================\n        # 规则1：\n        # indicator_code 必须为10位\n        # ==================================================\n\n        if len(indicator_code) != 10:\n\n            add_remark(\n                remarks,\n                \"指标代码长度不是10位\"\n            )\n\n        # ==================================================\n        # 规则2：\n        # 信息发布日期不能大于当前系统日期\n        # ==================================================\n\n        if (\n            publictime_date is not None\n            and publictime_date > today\n        ):\n\n            add_remark(\n                remarks,\n                \"信息发布日期-信息发布日期大于当前系统日期\"\n            )\n\n        # ==================================================\n        # 规则3：\n        # 信息发布日期不能小于截止日期\n        # ==================================================\n\n        if (\n            publictime_date is not None\n            and end_date_obj is not None\n            and publictime_date < end_date_obj\n        ):\n\n            add_remark(\n                remarks,\n                \"信息发布日期-信息发布日期小于截止日期\"\n            )\n\n        # ==================================================\n        # 规则4：\n        # indicator_release_frequency\n        # 根据披露频率判断对应周期末\n        # ==================================================\n\n        if end_date_obj is not None:\n\n            # =========================\n            # 月频\n            # =========================\n\n            if indicator_release_frequency == \"月\":\n\n                if not is_month_end(\n                    end_date_obj\n                ):\n\n                    add_remark(\n                        remarks,\n                        \"截止日期不是月末\"\n                    )\n\n            # =========================\n            # 季频\n            # =========================\n\n            elif indicator_release_frequency == \"季\":\n\n                if not is_quarter_end(\n                    end_date_obj\n                ):\n\n                    add_remark(\n                        remarks,\n                        \"截止日期不是季末\"\n                    )\n\n            # =========================\n            # 半年频\n            # =========================\n\n            elif indicator_release_frequency == \"半年\":\n\n                if not is_half_year_end(\n                    end_date_obj\n                ):\n\n                    add_remark(\n                        remarks,\n                        \"截止日期不是半年末\"\n                    )\n\n            # =========================\n            # 年频\n            # =========================\n\n            elif indicator_release_frequency == \"年\":\n\n                if not is_year_end(\n                    end_date_obj\n                ):\n\n                    add_remark(\n                        remarks,\n                        \"截止日期不是年末\"\n                    )\n\n        # ==================================================\n        # 规则5：\n        # problem_fin_time 独立判断\n        #\n        # 1002 → 月末\n        # 1003 → 季末\n        # 1004 → 年末\n        # ==================================================\n\n        if (\n            has_value(\n                problem_fin_time\n            )\n            and end_date_obj is not None\n        ):\n\n            problem_text = str(\n                problem_fin_time\n            )\n\n            # =========================\n            # 1002：必须为月末\n            # =========================\n\n            if (\n                \"1002\" in problem_text\n                and not is_month_end(\n                    end_date_obj\n                )\n            ):\n\n                add_remark(\n                    remarks,\n                    \"非月末数据\"\n                )\n\n            # =========================\n            # 1003：必须为季末\n            # =========================\n\n            if (\n                \"1003\" in problem_text\n                and not is_quarter_end(\n                    end_date_obj\n                )\n            ):\n\n                add_remark(\n                    remarks,\n                    \"非季末数据\"\n                )\n\n            # =========================\n            # 1004：必须为年末\n            # =========================\n\n            if (\n                \"1004\" in problem_text\n                and not is_year_end(\n                    end_date_obj\n                )\n            ):\n\n                add_remark(\n                    remarks,\n                    \"非年末数据\"\n                )\n\n        # ==================================================\n        # 有任意异常\n        # → 放入 warningdata\n        # ==================================================\n\n        if remarks:\n\n            warning_item = data.copy()\n\n            warning_item[\n                \"remark\"\n            ] = \"；\".join(\n                remarks\n            )\n\n            warningdata.append(\n                warning_item\n            )\n\n    # ==================================================\n    # 没有异常\n    # → 生成 empty 占位\n    # ==================================================\n\n    if not warningdata:\n\n        warningdata.append({\n            \"indicator_code\": \"empty\",\n            \"indicator_name\": \"empty\",\n            \"indicator_data\": \"empty\",\n            \"end_date\": \"\",\n            \"publictime\": \"\",\n            \"indicator_release_frequency\": \"\",\n            \"problem_fin_time\": \"\",\n            \"remark\": \"\"\n        })\n\n    # ==================================================\n    # 输出\n    # ==================================================\n\n    return {\n        \"OUTDATA\": OUTDATA,\n        \"warningdata\": warningdata\n    }",
