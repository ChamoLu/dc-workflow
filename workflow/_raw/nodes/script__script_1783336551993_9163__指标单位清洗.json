    "scriptType": "Python3",
    "scriptCode": "from decimal import Decimal, InvalidOperation\n\n\ndef to_decimal(value, default=\"1\"):\n    try:\n        if value is None:\n            return Decimal(default)\n\n        if isinstance(value, list):\n            if len(value) == 0:\n                return Decimal(default)\n            value = value[0]\n\n        if isinstance(value, dict):\n            value = value.get(\"convert_ratio\", default)\n\n        value = str(value).replace(\",\", \"\").strip()\n\n        if value == \"\":\n            return Decimal(default)\n\n        return Decimal(value)\n\n    except (InvalidOperation, TypeError, ValueError):\n        return Decimal(default)\n\n\ndef main(params):\n    OUTDATA = params.get(\"OUTDATA\", [])\n\n    # 转换率为空/异常时默认 1\n    convert_ratio = to_decimal(\n        params.get(\"convert_ratio\"),\n        \"1\"\n    )\n\n    for item in OUTDATA:\n        indicator_data = item.get(\"indicator_data\")\n\n        # 前面已经校验过，empty 直接传递\n        if indicator_data == \"empty\":\n            continue\n\n        value = to_decimal(indicator_data, \"0\")\n\n        item[\"indicator_data\"] = str(\n            value * convert_ratio\n        )\n\n    return {\n        \"OUTDATA\": OUTDATA\n    }",
