      }
    ],
    "scriptType": "Python3",
    "scriptCode": "import requests\nfrom io import StringIO\nimport calendar\n\nBASE_DOWNLOAD_URL = \"http://service-1.example.invalid/api/file/download/\"\n\ndef format_end_date(date_str):\n    \"\"\"\n    将YYYYMM转换为YYYY-MM-DD（月末）\n    例如：\n    202607 -> 2026-07-31\n    \"\"\"\n    date_str = str(date_str).strip()\n    if len(date_str) != 6:\n        return date_str\n    year = int(date_str[:4])\n    month = int(date_str[4:6])\n    last_day = calendar.monthrange(year, month)[1]\n    return f\"{year}-{month:02d}-{last_day:02d}\"\n\ndef main(params):\n    file_md5 = params.get(\"fileMd5\")\n\n    if not file_md5:\n        return {\n            \"code\": -1,\n            \"msg\": \"缺少fileMd5\",\n            \"OUTDATA\": []\n        }\n\n    OUTDATA = []\n\n    try:\n        url = BASE_DOWNLOAD_URL + file_md5\n        response = requests.get(url)\n\n        if response.status_code != 200:\n            return {\n                \"code\": -1,\n                \"msg\": \"文件下载失败\",\n                \"OUTDATA\": []\n            }\n\n        content = response.content.decode(\"utf-8\")\n\n        for line in StringIO(content):\n            line = line.strip()\n            if not line:\n                continue\n\n            parts = line.split(\",\")\n            if len(parts) != 2:\n                continue\n\n            OUTDATA.append({\n                \"end_date\": format_end_date(parts[0]),\n                \"indicator_data\": parts[1].strip()\n            })\n\n        return {\n            \"code\": 0,\n            \"msg\": \"解析成功\",\n            \"OUTDATA\": OUTDATA\n        }\n\n    except Exception as e:\n        return {\n            \"code\": -1,\n            \"msg\": str(e),\n            \"OUTDATA\": []\n        }",
